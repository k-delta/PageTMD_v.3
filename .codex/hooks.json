{
  "description": "Repository lifecycle hooks for irreversible-command protection, diff hygiene, focused session context, specialized subagent reports, and evidence-based completion.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block-dangerous-commands.py\"",
            "timeout": 5,
            "statusMessage": "Checking irreversible command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check-diff-hygiene.py\"",
            "timeout": 5,
            "statusMessage": "Checking diff hygiene"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/load-session-context.py\"",
            "timeout": 5,
            "statusMessage": "Loading focused repository context",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(architecture-reviewer|database-reviewer|performance-reviewer|security-reviewer|test-reviewer|test-runner)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-subagent-report.py\"",
            "timeout": 5,
            "statusMessage": "Checking specialized subagent report"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-before-stop.sh\"",
            "timeout": 5,
            "statusMessage": "Checking completion evidence"
          }
        ]
      }
    ]
  }
}
